rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwnUser(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function entitlementFieldMissingOnCreate() {
      return !request.resource.data.keys().hasAny(["entitlement", "profilePhotoPath", "profilePhotoUpdatedAt", "profilePhotoDeletionStartedAt"]);
    }

    function entitlementFieldUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["entitlement", "profilePhotoPath", "profilePhotoUpdatedAt", "profilePhotoDeletionStartedAt"]);
    }

    match /users/{uid} {
      allow read: if isOwnUser(uid);
      allow create: if isOwnUser(uid) && entitlementFieldMissingOnCreate();
      allow update: if isOwnUser(uid) && entitlementFieldUnchanged();
      allow delete: if false;

      match /nutritionMeals/{mealId} {
        allow read, create, update, delete: if isOwnUser(uid);
      }

      match /nutritionDays/{dateKey} {
        allow read, delete: if isOwnUser(uid) && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        allow create, update: if isOwnUser(uid)
          && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['mealNames', 'updatedAt'])
          && request.resource.data.mealNames is map
          && request.resource.data.mealNames.size() <= 60
          && request.resource.data.updatedAt is timestamp;
      }

      match /nutritionSavedMeals/{savedMealId} {
        allow read, create, update, delete: if isOwnUser(uid);
      }

      match /sleepSessions/{sessionId} {
        allow read, delete: if isOwnUser(uid);
        allow create, update: if isOwnUser(uid)
          && request.resource.data.id == sessionId
          && (request.resource.data.dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
              || (request.resource.data.dateKey == 'undated' && request.resource.data.kind == 'legacy'))
          && request.resource.data.source in ['manual', 'health']
          && request.resource.data.kind in ['session', 'duration', 'legacy']
          && request.resource.data.hours is number
          && request.resource.data.hours >= 0 && request.resource.data.hours <= 24
          && request.resource.data.excluded is bool
          && request.resource.data.providerDeleted is bool;
      }

      match /workouts/{workoutId} {
        allow read, create, update, delete: if isOwnUser(uid);
      }

      match /routines/{routineId} {
        allow read, create, update, delete: if isOwnUser(uid);
      }
    }
  }
}
