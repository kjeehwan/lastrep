{
  "name": "lastrep",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android:dev": "eas build -p android --profile development",
    "build:android:dev-standalone": "eas build -p android --profile preview",
    "build:android:prod": "eas build -p android --profile production",
    "verify:android-native": "node scripts/verify-android-native.js",
    "clean:dev-artifacts": "node scripts/clean-dev-artifacts.js",
    "start:dev-client": "node scripts/start-dev-client-android.js",
    "start:dev-client:android": "node scripts/start-dev-client-android.js",
    "start:dev-client:clear": "node scripts/start-dev-client-android.js --clear",
    "start:dev-client:fast": "node scripts/start-dev-client-android.js --fast",
    "start:dev-client:fast:clear": "node scripts/start-dev-client-android.js --fast --clear",
    "web": "expo start --web",
    "check:web-export": "expo export --platform web",
    "lint": "expo lint",
    "test": "vitest run",
    "test:firestore-rules": "firebase emulators:exec --only firestore \"npx vitest run src/firestore.rules.test.ts\"",
    "vercel-build": "node scripts/write-google-services.js",
    "eas-build-pre-install": "node scripts/write-google-services.js",
    "import:food-db": "node scripts/import-food-db.mjs"
  },
  "postinstall": "node scripts/patch-tslib.js && node scripts/patch-health-connect.js",
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-community/slider": "5.2.0",
    "@react-native-firebase/analytics": "^23.8.6",
    "@react-native-firebase/app": "^23.8.6",
    "@react-native-firebase/auth": "^23.8.6",
    "@react-native-firebase/firestore": "^23.8.6",
    "@react-native-firebase/storage": "^23.8.6",
    "@react-native-google-signin/google-signin": "^16.0.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.8.2",
    "@react-navigation/elements": "^2.8.1",
    "@react-navigation/native": "^7.1.19",
    "@react-navigation/native-stack": "^7.6.2",
    "expo": "57",
    "expo-asset": "~57.0.3",
    "expo-audio": "~57.0.0",
    "expo-auth-session": "~57.0.2",
    "expo-build-properties": "~57.0.3",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.5",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.0",
    "expo-image": "~57.0.0",
    "expo-image-picker": "~57.0.2",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.2",
    "expo-router": "~57.0.4",
    "expo-splash-screen": "~57.0.2",
    "expo-status-bar": "~57.0.0",
    "expo-symbols": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-web-browser": "~57.0.0",
    "firebase": "^12.9.0",
    "lucide-react-native": "^0.552.0",
    "moti": "^0.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health-connect": "^3.5.0",
    "react-native-purchases": "^9.10.4",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.0",
    "tslib": "2.6.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/native",
        "@react-navigation/bottom-tabs",
        "@react-navigation/native-stack"
      ]
    },
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "private": true
}
