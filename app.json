{
  "expo": {
    "name": "lastrep",
    "slug": "lastrep",
    "owner": "kjeehwan",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/logo-phone-icon.png",
    "scheme": "lastrep",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.kjeehwan.lastrep",
      "supportsTablet": true
    },
    "android": {
      "package": "com.kjeehwan.lastrep",
      "minSdkVersion": 26,
      "permissions": [
        "android.permission.health.READ_SLEEP"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-phone-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@react-native-firebase/app/app.plugin.js",
      "react-native-health-connect",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-splash.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@react-native-google-signin/google-signin/app.plugin.js",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1011197324131-qavna1bbp3mm9irs056p57o38pg039kc"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f0ac21ac-dada-4acd-bc9d-1b7371a018bf"
      }
    }
  }
}
